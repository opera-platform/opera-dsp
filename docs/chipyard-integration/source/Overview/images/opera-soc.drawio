  <diagram id="runtime-data-flow" name="2. Runtime Data Flow">
    <mxGraphModel dx="1800" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="&lt;b&gt;End-to-End Runtime Data Flow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="900" height="42" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="What the Rocket firmware does between raw Ethernet reception and OPERA DSP execution" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="42" y="62" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="phase_rx" value="&lt;b&gt;A · RECEIVE INPUT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#065F46;fontSize=13;align=left;spacingLeft=14;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="115" width="1680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="rx_pc" value="&lt;b&gt;1 · PC transfer tool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Quantizes text samples to packed complex Q2.14&lt;br&gt;and sends chunks in raw L2 frames (0x88B5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="195" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rx_phy" value="&lt;b&gt;2 · PHY + RGMII MAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;RTL8211E → 4-bit DDR RGMII&lt;br&gt;Forencich MAC emits byte stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="195" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rx_front" value="&lt;b&gt;3 · Ethernet frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Packs bytes LSB-first into 64-bit beats&lt;br&gt;publishes true RX length; asserts TLAST&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="195" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rx_dma" value="&lt;b&gt;4 · Ethernet DMA (S2M)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Frame-aware write terminates on TLAST&lt;br&gt;through FBUS into RX bounce buffer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C4B5FD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="905" y="195" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rx_bounce" value="&lt;b&gt;5 · RX bounce&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;0x0800_D000 · 4 KiB&lt;br&gt;on-chip scratchpad&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1185" y="195" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rx_fw" value="&lt;b&gt;6 · Rocket firmware&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;C.FLUSH + fence; copies frame → rx_frame → file_buffer&lt;br&gt;validates length, sequence and CRC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1435" y="195" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="phase_dsp" value="&lt;b&gt;B · PROCESS THROUGH OPERA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.5;fontColor=#9A3412;fontSize=13;align=left;spacingLeft=14;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="355" width="1680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="dsp_input" value="&lt;b&gt;7 · DSP input region&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Rocket writes 32-bit packed Q2.14 samples&lt;br&gt;0x0800_0000 .. 0x0800_3FFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="435" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dsp_setup" value="&lt;b&gt;8 · Rocket programs MMIO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Window / FFT / LogMag / CFAR configuration&lt;br&gt;DMA M2S=input; S2M=output; then triggers both&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="435" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dsp_m2s" value="&lt;b&gt;9 · DSP DMA M2S&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Reads 64-bit beats&lt;br&gt;two 32-bit samples per beat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FED7AA;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="645" y="435" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dsp_pipe" value="&lt;b&gt;10 · AXI4-Stream DSP pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#7C2D12&quot;&gt;64→32 + TLAST/256  →  Hamming window  →  FFT-256  →  log magnitude  →  CA-CFAR&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569&quot;&gt;ready/valid backpressure is preserved end-to-end&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2.5;fontColor=#9A3412;fontSize=13;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="885" y="425" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dsp_output" value="&lt;b&gt;11 · DSP DMA S2M&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;One packed 64-bit CFAR result per bin&lt;br&gt;writes 0x0800_4000 .. 0x0800_BFFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDBA74;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1435" y="435" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="phase_tx" value="&lt;b&gt;C · RETURN RESULTS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#3730A3;fontSize=13;align=left;spacingLeft=14;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="45" y="605" width="1680" height="42" as="geometry" />
        </mxCell>
        <mxCell id="tx_fw" value="&lt;b&gt;12 · Rocket firmware&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Polls DMA completion, reads CFAR words,&lt;br&gt;packs response + CRC into Ethernet protocol&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1435" y="690" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tx_bounce" value="&lt;b&gt;13 · TX bounce&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;0x0800_C000 · 4 KiB&lt;br&gt;cache cleaned before DMA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1185" y="690" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tx_dma" value="&lt;b&gt;14 · Ethernet DMA (M2S)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Reads 64-bit beats after firmware queues&lt;br&gt;the exact byte length in frontend CSR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C4B5FD;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="905" y="690" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tx_front" value="&lt;b&gt;15 · Frontend + MAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Unpacks 64-bit beats to bytes; trims padding&lt;br&gt;with queued length; emits RGMII frame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="690" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tx_phy" value="&lt;b&gt;16 · RTL8211E PHY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;RGMII to copper Ethernet&lt;br&gt;link configured over MDIO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="345" y="690" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tx_pc" value="&lt;b&gt;17 · PC receives result&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Verifies transfer CRC and writes rx_file.csv&lt;br&gt;threshold · CUT · bin · peak · raw word&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;shadow=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="690" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="rx_pc" target="rx_phy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="rx_phy" target="rx_front">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="rx_front" target="rx_dma">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="rx_dma" target="rx_bounce">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="CPU copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rx_bounce" target="rx_fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="validated samples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rx_fw" target="dsp_input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1710" y="325" />
              <mxPoint x="180" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r7" value="MMIO setup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dsp_input" target="dsp_setup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EA580C;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="dsp_setup" target="dsp_m2s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r9" value="AXI4-Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EA580C;strokeWidth=3;endArrow=block;endFill=1;fontSize=10;fontColor=#9A3412;labelBackgroundColor=#FFF7ED;" edge="1" parent="1" source="dsp_m2s" target="dsp_pipe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r10" value="64-bit/bin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EA580C;strokeWidth=3;endArrow=block;endFill=1;fontSize=10;fontColor=#9A3412;labelBackgroundColor=#FFF7ED;" edge="1" parent="1" source="dsp_pipe" target="dsp_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r11" value="CPU reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dsp_output" target="tx_fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r12" value="frame copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tx_fw" target="tx_bounce">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="tx_bounce" target="tx_dma">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="tx_dma" target="tx_front">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="tx_front" target="tx_phy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="tx_phy" target="tx_pc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="regions" value="&lt;b&gt;NON-OVERLAPPING ON-CHIP SCRATCHPAD LAYOUT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;font-size:11px;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#FFEDD5;border:1px solid #FDBA74&quot;&gt;&lt;b&gt;DSP input&lt;/b&gt;&lt;br&gt;0x0800_0000 – 0x0800_3FFF&lt;/td&gt;&lt;td style=&quot;background:#FED7AA;border:1px solid #FB923C&quot;&gt;&lt;b&gt;DSP output&lt;/b&gt;&lt;br&gt;0x0800_4000 – 0x0800_BFFF&lt;/td&gt;&lt;td style=&quot;background:#D1FAE5;border:1px solid #34D399&quot;&gt;&lt;b&gt;Ethernet TX&lt;/b&gt;&lt;br&gt;0x0800_C000 – 0x0800_CFFF&lt;/td&gt;&lt;td style=&quot;background:#A7F3D0;border:1px solid #10B981&quot;&gt;&lt;b&gt;Ethernet RX&lt;/b&gt;&lt;br&gt;0x0800_D000 – 0x0800_DFFF&lt;/td&gt;&lt;td style=&quot;background:#E2E8F0;border:1px solid #94A3B8&quot;&gt;&lt;b&gt;Reserved&lt;/b&gt;&lt;br&gt;0x0800_E000 – 0x0800_FFFF&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacing=12;shadow=1;arcSize=10;" vertex="1" parent="1">
