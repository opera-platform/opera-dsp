        <mxCell id="e_uart" value="load .riscv / HTIF console" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B5CF6;strokeWidth=1.8;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;" parent="1" source="host_uart" target="uart_tsi" edge="1">
