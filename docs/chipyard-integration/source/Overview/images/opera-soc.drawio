            <Array as="points">
              <mxPoint x="1000" y="440" />
              <mxPoint x="485" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_eth_dma_front" value="64-bit AXI4-Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2.5;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=10;fontColor=#065F46;labelBackgroundColor=#F0FDFA;" parent="1" source="eth_dma" target="frontend" edge="1">
          <mxGeometry relative="1" as="geometry" />
