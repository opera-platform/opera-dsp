        <mxCell id="e_phy_pc" value="eth cable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;" parent="1" source="phy" target="pc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mdio_iobuf" value="MDC / MDIO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=1.8;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=10;fontColor=#115E59;labelBackgroundColor=#FFFFFF;" parent="1" source="mdio" target="mdio_iobuf" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_iobuf_phy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D9488;strokeWidth=1.8;startArrow=block;startFill=1;endArrow=block;endFill=1;" parent="1" source="mdio_iobuf" target="phy" edge="1">
          <mxGeometry relative="1" as="geometry" />
