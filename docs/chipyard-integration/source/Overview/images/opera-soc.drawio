        <mxCell id="e_front_mac" value="byte AXI4-Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2.5;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=10;fontColor=#065F46;labelBackgroundColor=#F0FDFA;" parent="1" source="frontend" target="mac" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mac_pins" value="RGMII" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#047857;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=11;fontColor=#065F46;labelBackgroundColor=#FFFFFF;" parent="1" source="mac" target="rgmii_pins" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pins_phy" value="4-bit DDR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=3;startArrow=block;startFill=1;endArrow=block;endFill=1;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" parent="1" source="rgmii_pins" target="phy" edge="1">
          <mxGeometry relative="1" as="geometry" />
