        <mxCell id="e_pll_mac" value="GTX clocks + reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B5CF6;strokeWidth=2;dashed=1;dashPattern=5 4;endArrow=block;endFill=1;fontSize=10;fontColor=#5B21B6;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="eth_pll" target="mac" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
